{
  "request": {
    "method": "POST",
    "urlPath": "/payments",
    "bodyPatterns": [
      {
        "matchesJsonPath": {
          "expression": "$.orderId",
          "matches": ".*reject.*"
        }
      }
    ]
  },
  "response": {
    "status": 200,
    "headers": { "Content-Type": "application/json" },
    "jsonBody": {
      "transactionId": "txn-rejected-001",
      "status": "REJECTED"
    }
  },
  "priority": 1
}
